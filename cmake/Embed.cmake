# embed_files(<output.cpp> <file>...)
#
# Writes a C++ source holding the bytes of the files, which resources::Files() (src/Resources.h) lists by
# file name. CMake runs again, and the source is written again, when one of the files changes.
function(embed_files output)
    string(REPEAT "[0-9a-f]" 64 line_of_hex) # 32 bytes a line
    set(arrays "")
    set(entries "")
    set(index 0)

    foreach(path IN LISTS ARGN)
        get_filename_component(name "${path}" NAME)
        file(READ "${path}" hex HEX)
        string(REGEX REPLACE "(${line_of_hex})" "\\1\n    " hex "${hex}")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(STRIP "${bytes}" bytes)
        string(APPEND arrays "constexpr unsigned char file${index}[] = {\n    ${bytes}\n};\n\n")
        string(APPEND entries "    {\"${name}\", file${index}},\n")
        math(EXPR index "${index} + 1")
    endforeach()

    set(content "// Generated by cmake/Embed.cmake from the shaders and the icon. Do not edit.\n\n")
    string(APPEND content "#include \"Resources.h\"\n\nnamespace {\n\n${arrays}")
    string(APPEND content "constexpr resources::File files[] = {\n${entries}};\n\n} // namespace\n\n")
    string(APPEND content "std::span<const resources::File> resources::Files()\n{\n    return files;\n}\n")

    # Written through a copy, so that the source keeps its time stamp, and is not compiled again, while it is the same.
    file(WRITE "${output}.new" "${content}")
    configure_file("${output}.new" "${output}" COPYONLY)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${ARGN})
endfunction()
